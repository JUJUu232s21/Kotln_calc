<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#222222"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:text="Котлин калькулятор"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/black" />

        <EditText
            android:id="@+id/getResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="88sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:maxLines="4"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="10dp"
            android:gravity="end|center"
            android:text="0"
            android:textColor="@color/white"
            android:textSize="45sp"
            android:background="@drawable/bg_edit" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:rippleColor="@android:color/transparent"
                android:onClick="C"
                android:insetTop="0dp"
                android:textColor="@color/white"
                android:text="C"
                android:textStyle="bold"
                android:textSize="20sp"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#333333"/>

            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                app:rippleColor="@android:color/transparent"
                android:text="%"
                android:onClick="proc"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="20sp"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#333333"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:rippleColor="@android:color/transparent"
                android:insetTop="0dp"
                android:text="⌫"
                android:textColor="@color/white"
                android:onClick="del"
                android:textStyle="bold"
                android:textSize="20sp"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#333333"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:onClick="delenie"
                android:insetTop="0dp"
                app:rippleColor="@android:color/transparent"
                android:text="÷"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#333333"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:text="7"
                android:onClick="seven"
                app:rippleColor="@android:color/transparent"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#111111"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:text="8"
                android:onClick="eight"
                android:textStyle="bold"
                app:rippleColor="@android:color/transparent"
                android:textSize="20sp"
                android:insetBottom="0dp"
                android:textColor="@color/white"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#111111"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:onClick="nine"
                app:rippleColor="@android:color/transparent"
                android:text="9"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="20sp"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#111111"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:onClick="multip"
                app:rippleColor="@android:color/transparent"
                android:text="x"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="20sp"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#333333"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:text="4"
                android:onClick="four"
                android:textStyle="bold"
                app:rippleColor="@android:color/transparent"
                android:textSize="20sp"
                android:insetBottom="0dp"
                android:textColor="@color/white"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#111111"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>


            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:text="5"
                android:textStyle="bold"
                android:textSize="20sp"
                android:onClick="five"
                android:textColor="@color/white"
                app:rippleColor="@android:color/transparent"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#111111"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:text="6"
                android:onClick="six"
                android:textColor="@color/white"
                app:rippleColor="@android:color/transparent"
                android:textStyle="bold"
                android:textSize="20sp"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#111111"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:text="-"
                android:onClick="minuse"
                app:rippleColor="@android:color/transparent"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#333333"/>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:text="1"
                android:textStyle="bold"
                app:rippleColor="@android:color/transparent"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:onClick="one"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#111111"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:text="2"
                android:onClick="two"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:insetBottom="0dp"
                app:rippleColor="@android:color/transparent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#111111"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:text="3"
                android:onClick="three"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:rippleColor="@android:color/transparent"
                android:textSize="20sp"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#111111"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:text="+"
                android:textStyle="bold"
                android:onClick="pluse"
                app:rippleColor="@android:color/transparent"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#333333"/>

        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="match_parent"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:text="0"
                android:onClick="o"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:rippleColor="@android:color/transparent"
                app:strokeColor="@color/black"
                android:backgroundTint="#111111"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:text="."
                android:onClick="point"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                app:rippleColor="@android:color/transparent"
                android:backgroundTint="#111111"/>
            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="0dp"/>

            <com.google.android.material.button.MaterialButton
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:insetTop="0dp"
                android:text="="
                android:layout_weight="2"
                android:textStyle="bold"
                android:onClick="resulte"
                android:textSize="20sp"
                android:textColor="@color/white"
                app:rippleColor="@android:color/transparent"
                android:insetBottom="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeWidth="2dp"
                app:strokeColor="@color/black"
                android:backgroundTint="#333333"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="match_parent"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
